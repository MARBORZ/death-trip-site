import rateLimit from "express-rate-limit";

export const contactRateLimiter = rateLimit({
  windowMs: 5 * 60 * 1000, 
  max: 5,                 
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    message: "Too many requests. Please try again later.",
  },
});
</file>

<file path="routes/contact.js">
import express from "express";
import { sendMail } from "../services/mailer.js";
import { contactRateLimiter } from "../middleware/rateLimit.js";

const router = express.Router();

router.post("/", contactRateLimiter, async (req, res) => {
    const { name, email, message, company } = req.body;

    if (!name || !email || !message) {
        return res.status(400).json({ message: "All fields are required" });
    }

    // Honeypot
    if (company) {
        console.warn("Honeypot triggered!");
        return res.status(200).json({ message: "Message sent successfully" });
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        return res.status(400).json({ message: "Invalid email format" });
    }

    try {
        await sendMail({ name, email, message });
        return res.status(200).json({ message: "Message sent successfully" });
    } catch (err) {
        console.error("Mailer Error:", err);
        return res.status(500).json({ message: "Failed to send message" });
    }
});

export default router;
</file>

<file path="services/mailer.js">
import { Resend } from "resend";

const resend = new Resend(process.env.RESEND_API_KEY);

export async function sendMail({ name, email, message }) {
  await resend.emails.send({
        from: "Amadi Masuev - Frontend Developer <contact@hdufndsk.site>",
        to: process.env.MAIL_TO,
        reply_to: email,
        subject: `New message from ${name}`,
        text: [
            `New contact message`,
            ``,
            `Name: ${name}`,
            `Email: ${email}`,
            ``,
            `Message:`,
            message,
        ].join("\n"),
    });
}
